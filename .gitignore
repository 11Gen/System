# ---- 数据与模型（体积大，不进版本库）----
data/raw/
data/dataset/
data/*.npz
models/*.pt
models/*.pth
.cache/

# ---- 实验结果产物 ----
# 说明：models/ 下的 .json/.csv/.txt 是训练与评估的输出，
# figures/ 是评估图表。它们体积不大，但也不进版本库，原因是：
#   1) 都能用仓库里的脚本重新生成（train_cnn.py / evaluate.py / run_experiments.py）
#   2) 同一个文件每次跑都会变，提交进去只会让 git 历史里全是噪音
figures/
models/

# ---- 用户数据（不进版本库）----
# 反馈记录是运行时产生的个人数据，不该提交 ——
# 别人 clone 下来会看到你的反馈内容，没有意义。
data/feedback/
# 单测用的临时目录（测试结束会自己删，这里只是保险）
.test_tmp_feedback/

# ---- 训练中间产物 ----
*.pyc
__pycache__/
*.pyo
.pytest_cache/

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# ---- 凭证（绝对不能提交）----
.streamlit/secrets.toml
kaggle.json
.env

# 说明：
# data/nutrition_db.csv 和 data/ingredients_cn.csv 是"生成物但需要版本控制"——
# 它们是营养估算的数据基础，改动会影响所有计算结果，
# 所以故意不忽略，让每次变更都能在 git 里看到。
